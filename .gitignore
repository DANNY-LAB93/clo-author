# ==============================================================================
# .gitignore for Academic Claude Code Projects
# ==============================================================================

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.synctex.gz
*.run.xml
*-blx.bib

# Compiled PDFs (uncomment to track specific PDFs)
# *.pdf

# Python
__pycache__/
*.pyc
*.pyo

# R
.Rproj.user/
.Rhistory
.RData
.Rdata

# OS files
.DS_Store
Thumbs.db

# Claude Code local files (not shared across machines)
.claude/settings.local.json
.claude/state/*
!.claude/state/*.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Quarto rendering artifacts
/.quarto/
paper/quarto/*_files/
paper/quarto/.quarto/

# Output artifacts — uncomment lines below based on your preference
# *.rds
# output/**/*.rds
docs/

# Generated HTML reports (regenerated by scripts/generate_dashboard.py and generate_html_report.py)
project_dashboard.html
quality_reports/**/*.html

# LaTeX intermediates (regenerated by latexmk)
*.bcf
*.xdv
# ATENCION. scopus_armB.csv (181 MB) se ignora por tamano, pero es una FUENTE
# del manifiesto: sin el, `build_screening_corpus.py` no puede reconstruir el
# corpus y `check_pipeline_coherence.py` falla. Ya desaparecio una vez del
# disco y hubo que rescatarlo de un commit anterior (d39d39f). Guarde una
# copia fuera del repositorio antes de limpiar nada.
#   git show d39d39f:revision_sistematica/busqueda/scopus_armB.csv > <destino>
revision_sistematica/busqueda/scopus_armB.csv
revision_sistematica/cribado/.screening_cache/
